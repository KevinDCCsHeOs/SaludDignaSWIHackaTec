# Puerto del núcleo API (REST + Socket.IO)
PORT=3000
NODE_ENV=development

# Conexión a MySQL 8 con soporte completo utf8mb4 (acentos y emojis de WhatsApp).
# Nunca subir valores reales en `.env`; copiar este archivo a `.env` localmente.
DATABASE_URL="mysql://salud_digna_app:CAMBIAR_CONTRASENA@localhost:3306/salud_digna?charset=utf8mb4"

# Redis 7 para Streams (eventos), caché de contexto y códigos OTP
REDIS_URL="redis://localhost:6379"

# Secretos JWT (#6) — generar con: openssl rand -hex 32
JWT_ACCESS_SECRET="REEMPLAZAR_CON_SECRETO_JWT_ACCESS"
JWT_REFRESH_SECRET="REEMPLAZAR_CON_SECRETO_JWT_REFRESH"
API_SERVICE_TOKEN="REEMPLAZAR_CON_TOKEN_SERVICIO_INTERNO"

# Claves para cifrado AES-256-GCM y hash determinista de CURP (módulo `privacidad`, #10).
ENCRYPTION_KEY="REEMPLAZAR_CON_LLAVE_HEX_DE_32_BYTES"
CURP_HASH_PEPPER="REEMPLAZAR_CON_PEPPER_ALEATORIO"

# Proveedor LLM configurable (#24) — opcional en desarrollo
LLM_PROVIDER="none"
LLM_API_KEY="REEMPLAZAR_SI_SE_ACTIVA_LLM"
