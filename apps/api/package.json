{
  "name": "@salud-digna/api",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo API (NestJS + Prisma ORM) para Salud Digna Omnicanal",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:format:check": "prisma format --check --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@salud-digna/shared": "*"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
