{
  "name": "@salud-digna/api",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo API (NestJS + Prisma ORM) para Salud Digna Omnicanal",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "prisma generate --schema=prisma/schema.prisma && tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "eval:ia": "node src/ia/eval/evaluar.mjs",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:format:check": "prisma format --check --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx prisma/seed.ts --reset"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@prisma/client": "^6.19.0",
    "@salud-digna/shared": "*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.4"
  }
}
