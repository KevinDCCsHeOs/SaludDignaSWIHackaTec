# Puerto del servicio de webhook de WhatsApp Cloud API
PORT=3001
NODE_ENV=development

# Conexión hacia el núcleo API (el bot nunca accede a MySQL directamente)
API_BASE_URL="http://localhost:3000"
API_SERVICE_TOKEN="REEMPLAZAR_CON_TOKEN_SERVICIO_INTERNO"

# Redis exclusivo para sesiones de diálogo (`wa:sesion:*`) y cola entrante
REDIS_URL="redis://localhost:6379"

# Credenciales de Meta WhatsApp Business Platform (Cloud API, #20)
META_VERIFY_TOKEN="REEMPLAZAR_CON_VERIFY_TOKEN"
META_APP_SECRET="REEMPLAZAR_CON_APP_SECRET"
META_ACCESS_TOKEN="REEMPLAZAR_CON_ACCESS_TOKEN"
META_PHONE_NUMBER_ID="REEMPLAZAR_CON_PHONE_NUMBER_ID"
