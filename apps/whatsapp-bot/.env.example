# Puerto del servicio de webhook de WhatsApp Cloud API (#20)
PORT=3001
NODE_ENV=development

# Conexión hacia el núcleo API (el bot nunca accede a MySQL directamente)
API_BASE_URL="http://localhost:3000"
API_SERVICE_TOKEN="REEMPLAZAR_CON_TOKEN_SERVICIO_INTERNO"

# Credenciales de Meta WhatsApp Business Platform (Cloud API, #20).
# Se obtienen en developers.facebook.com → tu app → WhatsApp → Configuración de la API.
# En producción el bot NO arranca si falta WA_VERIFY_TOKEN o WA_APP_SECRET.
WA_VERIFY_TOKEN="REEMPLAZAR_CON_VERIFY_TOKEN"
WA_APP_SECRET="REEMPLAZAR_CON_APP_SECRET"
WA_ACCESS_TOKEN="REEMPLAZAR_CON_ACCESS_TOKEN"
WA_PHONE_NUMBER_ID="REEMPLAZAR_CON_PHONE_NUMBER_ID"
