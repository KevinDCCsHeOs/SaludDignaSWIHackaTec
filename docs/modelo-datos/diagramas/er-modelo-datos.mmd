    enum tipo
    enum prioridad
    enum estatus
    enum nivel_escalamiento
    varchar region
    varchar asignado_a FK
    text resumen_ia
    datetime sla_vence_en
    boolean sla_vencido
    boolean es_demo
  }

  AUDITORIA {
    bigint id PK "Append-only"
    varchar usuario_id FK
    enum rol
    enum accion
    varchar entidad
    varchar entidad_id
    varchar paciente_id "Ref indexada sin cascade"
    enum canal
    varchar ip
    boolean exitoso
    json detalle_sin_pii
    datetime creado_en
  }

