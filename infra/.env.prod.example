# Variables de producción (#35). NO subir el archivo real: se genera en la VPS con
#   ./infra/scripts/generar-env.sh <dominio> <correo>
# y queda en infra/.env.prod con permisos 600.

# Dominio base: se publican app.<dominio>, api.<dominio> y wa.<dominio>
DOMINIO="ejemplo.com"
CORREO_LETSENCRYPT="equipo@ejemplo.com"

# MySQL (contraseñas aleatorias en hexadecimal, sin caracteres especiales para la URL)
MYSQL_ROOT_PASSWORD="generada"
MYSQL_PASSWORD="generada"

# Secretos del API (openssl rand -hex 32)
JWT_ACCESS_SECRET="generada"
JWT_REFRESH_SECRET="generada"
API_SERVICE_TOKEN="generada"
ENCRYPTION_KEY="generada-64-hex"
CURP_HASH_PEPPER="generada"

# WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp). Ver docs/whatsapp-meta.md
WA_VERIFY_TOKEN="generada"
WA_APP_SECRET=""
WA_ACCESS_TOKEN=""
WA_PHONE_NUMBER_ID=""

# Celular de quien opera el demo (debe estar en la lista de destinatarios de Meta).
# Se asigna a la paciente ficticia Ana para que WhatsApp la reconozca. Ej.: "5512345678"
DEMO_TELEFONO_PACIENTE=""

# Asistente con LLM (#24), opcional
LLM_PROVIDER="none"
LLM_API_KEY=""

# Notificaciones push reales a Expo (1 = apagadas)
EXPO_PUSH_DESHABILITADO="0"

# Respaldos externos y alertas operativas (#36), opcionales
BACKUP_REMOTO_DESTINO=""
BACKUP_REMOTO_LLAVE=""
ALERTA_WEBHOOK_URL=""
LOG_FORMATO="json"

# Temporizadores de sesión (traspaso v2): produccion (aviso 10 min, cierre 30 min, horario 15 min,
# permiso de canal 2 min) o exposicion (30 s, 60 s, 2 min, 20 s) para mostrar los relojes en vivo.
# Para la presentación ante el jurado se usa exposicion: una pausa de más de 60 s cierra la
# conversación de WhatsApp (al volver a escribir se pide el código y se retoma). Cambiar a
# produccion después del demo.
PLAZOS_PERFIL="exposicion"
